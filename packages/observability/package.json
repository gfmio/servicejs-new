{
  "name": "@servicejs/observability",
  "version": "0.1.0",
  "description": "Events-based observability system for ServiceJS - framework-agnostic tracing, metrics, and logging",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "observability",
    "tracing",
    "metrics",
    "logging",
    "telemetry",
    "opentelemetry",
    "prometheus",
    "statsd",
    "events",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@servicejs/result": "workspace:*",
    "@servicejs/option": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
