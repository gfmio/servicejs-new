{
  "name": "@servicejs/adapter-rabbitmq",
  "version": "0.1.0",
  "description": "RabbitMQ adapter for ServiceJS integration framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
