{
  "name": "@servicejs/adapter-sendgrid",
  "version": "0.1.0",
  "description": "SendGrid email adapter for ServiceJS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/result": "workspace:*",
    "@servicejs/adapter-email": "workspace:*"
  },
  "peerDependencies": {
    "@sendgrid/mail": "^8.1.4"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": ["servicejs", "adapter", "email", "sendgrid"]
}
