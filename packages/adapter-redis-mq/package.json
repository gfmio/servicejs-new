{
  "name": "@servicejs/adapter-redis-mq",
  "version": "0.1.0",
  "description": "Redis Pub/Sub message queue adapter for ServiceJS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/integration-mq": "workspace:*",
    "@servicejs/integrations": "workspace:*",
    "@servicejs/result": "workspace:*",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": [
    "servicejs",
    "adapter",
    "redis",
    "pubsub",
    "message-queue"
  ]
}
