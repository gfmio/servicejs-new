{
  "name": "@servicejs/core",
  "version": "0.1.0",
  "description": "Pure core of ServiceJS - URN, Message, Capability, Reducer, Component, Effect",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
