{
  "name": "@servicejs/adapter-cloudflare-d1",
  "version": "0.1.0",
  "description": "Cloudflare D1 database adapter for ServiceJS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/integration-database": "workspace:*",
    "@servicejs/integrations": "workspace:*",
    "@servicejs/result": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": [
    "servicejs",
    "adapter",
    "d1",
    "database",
    "cloudflare",
    "workers"
  ]
}
