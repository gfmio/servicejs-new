{
  "name": "@servicejs/di",
  "version": "0.1.0",
  "description": "Dependency injection and inversion of control for ServiceJS with capability-based architecture",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "servicejs",
    "dependency-injection",
    "di",
    "ioc",
    "inversion-of-control",
    "capabilities",
    "ports-and-adapters",
    "hexagonal-architecture"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@servicejs/result": "workspace:*",
    "@servicejs/option": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
