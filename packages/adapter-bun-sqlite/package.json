{
  "name": "@servicejs/adapter-bun-sqlite",
  "version": "0.1.0",
  "description": "SQLite database adapter for ServiceJS using bun:sqlite",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/integration-database": "workspace:*",
    "@servicejs/integrations": "workspace:*",
    "@servicejs/result": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.15",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": [
    "servicejs",
    "adapter",
    "sqlite",
    "database",
    "bun"
  ]
}
