{
  "name": "@servicejs/adapter-cloudflare-kv",
  "version": "0.1.0",
  "description": "Cloudflare KV cache adapter for ServiceJS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/result": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "@cloudflare/vitest-pool-workers": "^0.5.21",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8",
    "wrangler": "^3.105.0"
  },
  "keywords": [
    "servicejs",
    "adapter",
    "cloudflare",
    "kv",
    "cache"
  ]
}
