{
  "name": "@servicejs/runtime-browser",
  "version": "0.1.0",
  "description": "Browser runtime for ServiceJS - complete web platform integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "playwright test",
    "test:local": "playwright test",
    "test:browserstack": "BROWSERSTACK=true playwright test",
    "test:server": "bun run tests/e2e/test-server.ts",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "@servicejs/capability-env": "workspace:*",
    "@servicejs/capability-time": "workspace:*",
    "@servicejs/capability-lifecycle": "workspace:*",
    "@servicejs/capability-console": "workspace:*",
    "@servicejs/capability-http": "workspace:*",
    "@servicejs/capability-crypto": "workspace:*",
    "@servicejs/result": "workspace:*",
    "@servicejs/option": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "@playwright/test": "^1.40.0",
    "playwright": "^1.40.0"
  }
}
