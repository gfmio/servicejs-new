{
  "name": "@servicejs/adapter-upstash-redis",
  "version": "0.1.0",
  "description": "Upstash Redis adapter for edge-compatible caching",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/result": "workspace:*"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.0.0"
  },
  "devDependencies": {
    "@upstash/redis": "^1.35.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": ["servicejs", "adapter", "upstash-redis", "edge", "serverless"]
}
