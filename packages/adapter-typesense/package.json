{
  "name": "@servicejs/adapter-typesense",
  "version": "0.1.0",
  "description": "Typesense adapter for search engine",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/result": "workspace:*"
  },
  "peerDependencies": {
    "typesense": "^2.0.0"
  },
  "devDependencies": {
    "typesense": "^2.1.0",
    "testcontainers": "^10.13.2",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": ["servicejs", "adapter", "typesense"]
}
