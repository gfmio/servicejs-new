{
  "name": "@servicejs/config",
  "version": "0.1.0",
  "description": "Configuration reading, parsing, validation and transformation capability for ServiceJS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "servicejs",
    "capability",
    "config",
    "configuration",
    "json",
    "yaml",
    "toml",
    "validation",
    "zod"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@servicejs/result": "workspace:*",
    "@servicejs/option": "workspace:*",
    "zod": "^3.22.4",
    "yaml": "^2.3.4",
    "smol-toml": "^1.1.4",
    "ini": "^4.1.1",
    "jsonc-parser": "^3.2.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ini": "^4.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
