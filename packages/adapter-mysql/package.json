{
  "name": "@servicejs/adapter-mysql",
  "version": "0.1.0",
  "description": "MySQL/MariaDB adapter for ServiceJS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/result": "workspace:*",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "testcontainers": "^10.18.0",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": [
    "servicejs",
    "adapter",
    "mysql",
    "mariadb",
    "database",
    "sql"
  ]
}
