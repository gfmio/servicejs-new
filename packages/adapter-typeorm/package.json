{
  "name": "@servicejs/adapter-typeorm",
  "version": "0.1.0",
  "description": "TypeORM adapter for entity-based ORM",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/result": "workspace:*"
  },
  "peerDependencies": {
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "typeorm": "^0.3.0",
    "better-sqlite3": "^9.0.0",
    "reflect-metadata": "^0.1.13",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": ["servicejs", "adapter", "typeorm"]
}
