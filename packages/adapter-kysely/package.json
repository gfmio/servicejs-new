{
  "name": "@servicejs/adapter-kysely",
  "version": "0.1.0",
  "description": "Kysely query builder adapter for type-safe SQL",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servicejs/result": "workspace:*"
  },
  "peerDependencies": {
    "kysely": "^0.27.0"
  },
  "devDependencies": {
    "kysely": "^0.27.0",
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5"
  },
  "keywords": ["servicejs", "adapter", "kysely"]
}
