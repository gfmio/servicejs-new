{
  "name": "@actor-framework/example",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/main.ts",
    "dev:protocol": "bun run src/protocol-example.ts",
    "dev:pubsub": "bun run src/pubsub-example.ts",
    "build": "bun build src/main.ts --outdir ./dist --target bun"
  },
  "dependencies": {
    "@actor-framework/core": "workspace:*",
    "@actor-framework/mailbox": "workspace:*",
    "@actor-framework/patterns": "workspace:*",
    "@actor-framework/transport": "workspace:*",
    "@actor-framework/config": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.10",
    "typescript": "^5.6.3"
  }
}
